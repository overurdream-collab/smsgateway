<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug-only: allow Android user-installed CAs, retaining full TLS chain and hostname checks. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
